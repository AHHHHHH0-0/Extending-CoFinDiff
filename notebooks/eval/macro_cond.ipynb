        "\"\"\"\n",
        "4 — Pooled summary: concatenate all 25 micro cells per macro corner (coarse mixture).\n",
        "\"\"\"\n",
        "\n",
        "x_pool = np.linspace(-6, 6, 500)\n",
        "\n",
        "for model_key in MODEL_ORDER:\n",
        "    fig, ax = plt.subplots(figsize=(9, 5))\n",
        "\n",
        "    for _lab, ir, vix, color, leg in MACRO_CORNERS:\n",
        "        chunks = []\n",
        "        for trend in TRENDS:\n",
        "            for rv in RVS:\n",
        "                chunks.append(load_samples_pct(trend, rv, ir, vix, model_key).ravel())\n",
        "        flat = np.concatenate(chunks)\n",
        "        flat_std = (flat - flat.mean()) / flat.std()\n",
        "        kde_vals = gaussian_kde(flat_std, bw_method='scott')(x_pool)\n",
        "        ax.plot(x_pool, kde_vals, color=color, lw=2, alpha=0.9, label=leg)\n",
        "\n",
        "    ax.plot(x_pool, norm.pdf(x_pool), color=C_NORMAL, linestyle='--', linewidth=1.5, label='N(0,1)')\n",
        "    ax.set_yscale('log')\n",
        "    ax.set_ylim(1e-4, 1.0)\n",
        "    ax.set_xlim(-6, 6)\n",
        "    ax.set_xlabel('Return (standardized)')\n",
        "    ax.set_ylabel('Density')\n",
        "    ax.set_title(f'Pooled over 25 micro cells per macro corner ({MODEL_LABELS[model_key]})')\n",
        "    ax.legend(fontsize=8, loc='upper right')\n",
        "    ax.grid(axis='y', alpha=0.5)\n",
        "\n",
        "    plt.tight_layout()\n",
        "    out_path = f'../../figures/macro_pooled_kde_{model_key}.png'\n",
        "    plt.savefig(out_path, bbox_inches='tight')\n",
        "    plt.show()\n",
        "    print(f'Saved {out_path}')\n"
      ]
    }
