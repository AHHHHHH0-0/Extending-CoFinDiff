        "\"\"\"\n",
        "3 — 5×5 heatmaps: macro spread (max − min across four corners) per micro cell.\n",
        "\"\"\"\n",
        "\n",
        "\n",
        "def cell_excess_kurtosis(arr_pct):\n",
        "    return fisher_kurtosis(arr_pct).mean()\n",
        "\n",
        "\n",
        "def cell_std_pct(arr_pct):\n",
        "    return arr_pct.ravel().std()\n",
        "\n",
        "\n",
        "def macro_spread_grids(model_key):\n",
        "    spread_kurt = np.full((len(RVS), len(TRENDS)), np.nan)\n",
        "    spread_std = np.full((len(RVS), len(TRENDS)), np.nan)\n",
        "\n",
        "    for ri, rv in enumerate(RVS):\n",
        "        for ti, trend in enumerate(TRENDS):\n",
        "            k_vals, s_vals = [], []\n",
        "            for _lab, ir, vix, _c, _leg in MACRO_CORNERS:\n",
        "                arr = load_samples_pct(trend, rv, ir, vix, model_key)\n",
        "                k_vals.append(cell_excess_kurtosis(arr))\n",
        "                s_vals.append(cell_std_pct(arr))\n",
        "            spread_kurt[ri, ti] = max(k_vals) - min(k_vals)\n",
        "            spread_std[ri, ti] = max(s_vals) - min(s_vals)\n",
        "\n",
        "    return spread_kurt, spread_std\n",
        "\n",
        "\n",
        "spread_by_model = {}\n",
        "\n",
        "for model_key in MODEL_ORDER:\n",
        "    spread_kurt, spread_std = macro_spread_grids(model_key)\n",
        "    spread_by_model[model_key] = (spread_kurt, spread_std)\n",
        "\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n",
        "\n",
        "    for ax, data, title, cbar_label in [\n",
        "        (axes[0], spread_kurt, 'Excess kurtosis spread', 'Δ mean excess kurtosis'),\n",
        "        (axes[1], spread_std, 'Std spread', 'Δ path std (% per day)'),\n",
        "    ]:\n",
        "        im = ax.imshow(\n",
        "            data, aspect='auto', origin='lower', cmap='viridis',\n",
        "            extent=[min(TRENDS), max(TRENDS), min(RVS), max(RVS)],\n",
        "        )\n",
        "        ax.set_xticks(TRENDS)\n",
        "        ax.set_yticks(RVS)\n",
        "        ax.set_xlabel('Trend target (%)')\n",
        "        ax.set_ylabel('Realized vol target')\n",
        "        ax.set_title(title)\n",
        "        fig.colorbar(im, ax=ax, label=cbar_label)\n",
        "\n",
        "    fig.suptitle(\n",
        "        f'Macro sensitivity across micro grid ({MODEL_LABELS[model_key]})',\n",
        "        fontsize=12, y=1.02,\n",
        "    )\n",
        "    plt.tight_layout()\n",
        "    out_path = f'../../figures/macro_spread_heatmaps_{model_key}.png'\n",
        "    plt.savefig(out_path, bbox_inches='tight')\n",
        "    plt.show()\n",
        "    print(f'[{model_key}] mean spread (kurtosis): {np.nanmean(spread_kurt):.6f}')\n",
        "    print(f'[{model_key}] mean spread (std %): {np.nanmean(spread_std):.6e}')\n",
        "    print(f'Saved {out_path}')\n",
        "\n",
        "# Side-by-side kurtosis spread comparison\n",
        "fig, axes = plt.subplots(1, len(MODEL_ORDER), figsize=(6 * len(MODEL_ORDER), 5), sharey=True)\n",
        "vmin = min(spread_by_model[m][0].min() for m in MODEL_ORDER)\n",
        "vmax = max(spread_by_model[m][0].max() for m in MODEL_ORDER)\n",
        "\n",
        "for ax, model_key in zip(axes, MODEL_ORDER):\n",
        "    spread_kurt = spread_by_model[model_key][0]\n",
        "    im = ax.imshow(\n",
        "        spread_kurt, aspect='auto', origin='lower', cmap='viridis',\n",
        "        extent=[min(TRENDS), max(TRENDS), min(RVS), max(RVS)],\n",
        "        vmin=vmin, vmax=vmax,\n",
        "    )\n",
        "    ax.set_xticks(TRENDS)\n",
        "    ax.set_yticks(RVS)\n",
        "    ax.set_xlabel('Trend target (%)')\n",
        "    ax.set_ylabel('Realized vol target')\n",
        "    ax.set_title(MODEL_LABELS[model_key])\n",
        "    fig.colorbar(im, ax=ax, label='Δ mean excess kurtosis')\n",
        "\n",
        "fig.suptitle('Macro kurtosis sensitivity (shared color scale)', fontsize=12, y=1.02)\n",
        "plt.tight_layout()\n",
        "compare_path = '../../figures/macro_spread_heatmaps_compare.png'\n",
        "plt.savefig(compare_path, bbox_inches='tight')\n",
        "plt.show()\n",
        "print(f'Saved {compare_path}')\n"
      ]
    },
