        "\"\"\"\n",
        "Load helpers: ~% daily returns after per_path_normalize (same as prior macro eval).\n",
        "\"\"\"\n",
        "\n",
        "def load_samples_pct(trend, rv, ir, vix, model_key):\n",
        "    path = MODEL_DIRS[model_key] / condition_filename(trend, rv, ir, vix)\n",
        "    with open(path) as f:\n",
        "        payload = json.load(f)\n",
        "    samples = np.array(payload['samples'], dtype=np.float64)\n",
        "    t_tgt = payload['conditions']['trend']\n",
        "    r_tgt = payload['conditions']['realized_vol']\n",
        "    return per_path_normalize(samples, t_tgt, r_tgt, T) * 100.0\n",
        "\n",
        "\n",
        "def kde_standardized(flat_pct):\n",
        "    flat_std = (flat_pct - flat_pct.mean()) / flat_pct.std()\n",
        "    return gaussian_kde(flat_std, bw_method='scott')(x_grid)\n",
        "\n",
        "\n",
        "for model_key in MODEL_ORDER:\n",
        "    _t = load_samples_pct(0, 500, 0.15, 15.0, model_key)\n",
        "    print(f'[{model_key}] example cell: {_t.shape[0]} paths x {_t.shape[1]} steps')\n"
      ]
